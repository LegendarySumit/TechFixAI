# TechFixAI Observability Settings
# Copy to .env and fill in your values for production

# Structured Logging
LOG_LEVEL=INFO                          # DEBUG, INFO, WARNING, ERROR, CRITICAL
STRUCTURED_LOGGING_ENABLED=True         # Enable JSON-formatted logs with request IDs

# Sentry Error Tracking
SENTRY_DSN=                             # Leave empty to disable; get from https://sentry.io
SENTRY_TRACES_SAMPLE_RATE=0.1           # 10% of requests include tracing data (1.0 = 100%)
SENTRY_RELEASE=1.0.0                    # Version tag for Sentry (set this per deployment)

# Prometheus Metrics
METRICS_ENABLED=True                    # Expose /metrics endpoint
METRICS_PORT=9090                       # Port for Prometheus scraper (if running separately)

# Request Tracking
REQUEST_ID_HEADER=X-Request-ID          # Header name for request ID tracking
