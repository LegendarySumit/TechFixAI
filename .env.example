# ─────────────────────────────────────────────────────────────────────────────
# TechFixAI — Environment Variables Template
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME=TechFixAI
DEBUG=False

# Database (SQLite default — swap for PostgreSQL URL in production)
DATABASE_URL=sqlite:///./techfixai.db

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here

# Whisper AI model size: tiny | base | small | medium | large
WHISPER_MODEL=base

# Groq API  →  https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API  →  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Audio file storage
AUDIO_STORAGE_PATH=storage/audio
MAX_AUDIO_SIZE_MB=50

# Auto-assignment feature toggle
AUTO_ASSIGNMENT_ENABLED=True

# Google OAuth  →  https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
