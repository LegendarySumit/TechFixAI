# ─────────────────────────────────────────────────────────────────────────────
# TechFixAI — Environment Variables Template
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME=TechFixAI
DEBUG=False

# Database
# Local:   sqlite:///./techfixai.db
# Railway: copy the DATABASE_URL from your Railway PostgreSQL plugin (auto-set)
DATABASE_URL=sqlite:///./techfixai.db

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here
ADMIN_EMAILS=admin@yourdomain.com
PUBLIC_DEPLOYMENT=False

# Transport and web security (set TRUE in public deployments)
FORCE_HTTPS=False
SECURITY_HEADERS_ENABLED=True
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=True
HSTS_PRELOAD=True
REFERRER_POLICY=strict-origin-when-cross-origin

# Session cookie hardening (set SESSION_COOKIE_SECURE=False only for local HTTP dev)
SESSION_COOKIE_NAME=user_session
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30

# Brute-force protection
AUTH_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
AUTH_MAX_IP_ATTEMPTS=30
AUTH_MAX_ACCOUNT_ATTEMPTS=8

# Abuse protection: global and endpoint rate limits
GLOBAL_RATE_LIMIT_REQUESTS=180
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_REQUESTS=25
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_SIGNUP_RATE_LIMIT_REQUESTS=12
AUTH_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=60
VOICE_UPLOAD_RATE_LIMIT_REQUESTS=20
VOICE_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
TRANSLATE_RATE_LIMIT_REQUESTS=60
TRANSLATE_RATE_LIMIT_WINDOW_SECONDS=60

# Abuse protection: request body / upload caps
MAX_REQUEST_BODY_MB=60
MAX_UPLOAD_SIZE_MB=50
TRANSLATE_MAX_CHARS=5000

# Bot protection (set CAPTCHA_ENABLED=True and add keys in production)
CAPTCHA_ENABLED=False
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_REQUIRED_LOGIN=True
CAPTCHA_REQUIRED_SIGNUP=True

# Whisper AI model size (only relevant if using local fallback)
WHISPER_MODEL=base

# Encryption key rotation controls
ENCRYPTION_ENABLED=True
ENCRYPTION_KEY_VERSION=v1
ENCRYPTION_LEGACY_KEY_VERSIONS=

# Groq API  →  https://console.groq.com  (free, used for STT + LLM)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API  →  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Audio file storage
# Local:   ./storage/audio
# Railway: /tmp/audio  (ephemeral — files cleared on restart)
AUDIO_STORAGE_PATH=./storage/audio
MAX_AUDIO_SIZE_MB=50

# Auto-assignment feature toggle
AUTO_ASSIGNMENT_ENABLED=True

# Retention policies
DATA_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90

# CORS — comma-separated list of allowed origins
# Local:      http://localhost:8000
# Production: https://your-app.up.railway.app
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Google OAuth  →  https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Observability
LOG_LEVEL=INFO
STRUCTURED_LOGGING_ENABLED=True
REQUEST_ID_HEADER=X-Request-ID
METRICS_ENABLED=True

# Sentry (optional but recommended in production)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
